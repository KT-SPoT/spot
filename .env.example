# Copy to .env for an explicitly requested live Quant run.
# Address -> coordinates needs Kakao. Explicit coordinates skip Kakao.
KAKAO_REST_API_KEY=
SBIZ365_CERT_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
# Existing scaffold options; current Quant uses SBIZ365_CERT_KEY instead.
SMALL_BIZ_API_KEY=
YOUTUBE_API_KEY=
# Live Local/Trend search. Naver legacy Client ID/Secret or API Hub key ID/key.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# auto tries legacy, then API Hub on authentication failure. legacy / hub also supported.
NAVER_SEARCH_PROVIDER=auto
LLM_API_KEY=
# Optional semantic Critic: off by default; shadow records judgments only.
SPOT_SEMANTIC_MODE=off
# Complete HTTPS Chat Completions URL, no credential query parameters.
SPOT_LLM_ENDPOINT=
SPOT_LLM_MODEL=
# HTTP service: separate from provider keys. Generate locally; never commit values.
SPOT_API_TOKEN=
# offline performs connection tests without provider requests; explicitly set live for research.
SPOT_API_MODE=offline
